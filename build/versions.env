# adb's license notice (NOTICE.txt from Android SDK Platform-Tools 37.0.1, the adb
# in scrcpy 5.0.1), shipped as licenses/adb-NOTICE.txt. Only that file is used.
# "url sha256".
PLATFORM_TOOLS_MACOS="https://dl.google.com/android/repository/platform-tools_r37.0.1-darwin.zip ee39ad5967e95c2a07f04dbcbde96b1a0c916ba376096db5d2f498b7727a5d1d"
