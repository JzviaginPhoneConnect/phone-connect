# Pinned scrcpy release bundled into PhoneConnect, with the SHA-256 checksums
# published by scrcpy (SHA256SUMS.txt on its GitHub release). To update scrcpy,
# change the version and the four checksums below.
SCRCPY_VERSION=5.0.1
SHA256_MACOS_AARCH64=33611e51977a8289e2e124b220f727895181ef2eb9060e0987a4dc2db9cf0d6b
SHA256_MACOS_X86_64=31a5467a9e907f162b093267cbbab1276b15c6e709c2ea8159566a8d165beb50
SHA256_WIN64=b12a2c4ee8be317422451fc7dcf8ee20a71b5ea7ef9ad73ddd825a25316227a5
SHA256_WINARM64=16c3fc2068df64946f670e3504b4752073ebae47a416a45b46e79a5ab19c689b

# zstd, used by the Windows build to unpack the MSYS2 packages below (when zstd isn't
# already installed): the official Windows build from https://github.com/facebook/zstd
# releases (x64; runs on ARM Windows 11 too). "file sha256".
ZSTD_VERSION=1.5.7
ZSTD_WIN64="zstd-v1.5.7-win64.zip acb4e8111511749dc7a3ebedca9b04190e37a17afeb73f55d4425dbf0b90fad9"

# The shell PhoneConnect.sh runs on in Windows: MSYS2's zsh and the few tools the
# script uses, unmodified MSYS2 packages from https://repo.msys2.org/msys/x86_64/
# (x64; Windows on ARM runs them through its built-in emulation). Each line is
# "file sha256". To update one, take the new file name and its SHA256SUM from
# the package's page on https://packages.msys2.org.
MSYS2_PKG_RUNTIME="msys2-runtime-3.6.11-3-x86_64.pkg.tar.zst b6478bd1b4cb4b2e07c45db725fee93f9424c19fa248240dcb7b7f4187cd92db"
