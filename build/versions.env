# Source code of everything bundled (scrcpy and the libraries built into it, and every
# MSYS2 package above), as the GPL and LGPL require. It's published once per set of
# versions as the GitHub release THIRD_PARTY_SOURCES_TAG (build/collect-sources.sh,
# release job), which THIRD_PARTY_NOTICES.md links to. Whenever scrcpy or an MSYS2
# package changes: update these lines, bump the tag, and update the link there.
# "url sha256 [file name to save as]".
THIRD_PARTY_SOURCES_TAG=third-party-sources-1
SOURCE_SCRCPY="https://github.com/Genymobile/scrcpy/archive/refs/tags/v5.0.1.tar.gz a24b996ac23d0f674d3237c00b39a97829d8acbe9e1657a6c216fd51ea488ee5 scrcpy-5.0.1.tar.gz"
